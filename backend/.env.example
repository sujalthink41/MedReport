# Copy to .env and adjust. .env is gitignored and must never be committed.
# Every variable is prefixed MEDREPORT_ so it cannot collide with anything else
# in the environment.

MEDREPORT_ENVIRONMENT=local
MEDREPORT_DEBUG=true

# Comma-separated
MEDREPORT_CORS_ORIGINS=http://localhost:3000

# --- added in CP5 ---
# Ports 5433/6380, not the defaults: docker-compose avoids clashing with a
# natively installed Postgres or Redis on the same machine.
# MEDREPORT_DATABASE_URL=postgresql+asyncpg://medreport:medreport@localhost:5433/medreport

# --- added in CP12 ---
# MEDREPORT_REDIS_URL=redis://localhost:6380/0

# --- added in CP7 ---
# MEDREPORT_GOOGLE_CLIENT_ID=
# MEDREPORT_GOOGLE_CLIENT_SECRET=
# MEDREPORT_JWT_SECRET=

# --- added in CP10 ---
# MEDREPORT_STORAGE_BACKEND=local          # local | r2
# MEDREPORT_R2_ACCOUNT_ID=
# MEDREPORT_R2_ACCESS_KEY_ID=
# MEDREPORT_R2_SECRET_ACCESS_KEY=
# MEDREPORT_R2_BUCKET=

# --- added in CP16 ---
# MEDREPORT_OPENAI_API_KEY=
