# Copy to .env and adjust. .env is gitignored and must never be committed.
# Every variable is prefixed MEDREPORT_ so it cannot collide with anything else
# in the environment.

MEDREPORT_ENVIRONMENT=local
MEDREPORT_DEBUG=true

# Comma-separated. JSON array form also works.
MEDREPORT_CORS_ORIGINS=http://localhost:3000

# --- added in CP5 ---
# Ports 5433/6380, not the defaults: docker-compose avoids clashing with a
# natively installed Postgres or Redis on the same machine.
# MEDREPORT_DATABASE_URL=postgresql+asyncpg://medreport:medreport@localhost:5433/medreport

# --- added in CP12 ---
# MEDREPORT_REDIS_URL=redis://localhost:6380/0

# --- added in CP7 ---
# From Google Cloud Console > Credentials > OAuth 2.0 Client IDs (Web application).
# MEDREPORT_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# Must be at least 32 chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
# MEDREPORT_JWT_SECRET=

# --- added in CP10 ---
# THE plug/unplug switch. 'local' writes to ./.storage; 'r2' uses Cloudflare.
# Changing this value changes which adapter the whole app uses, and nothing in
# application/ or domain/ notices.
MEDREPORT_STORAGE_BACKEND=local
# MEDREPORT_STORAGE_LOCAL_ROOT=./.storage
#
# Cloudflare dashboard > R2 > Manage API Tokens > Create (Object Read & Write).
# MEDREPORT_R2_ACCOUNT_ID=
# MEDREPORT_R2_ACCESS_KEY_ID=
# MEDREPORT_R2_SECRET_ACCESS_KEY=
# MEDREPORT_R2_BUCKET=medreport-reports

# --- added in CP16 ---
# platform.openai.com > API keys. Needed to run the pipeline; everything is
# tested against a fake LLM without it.
MEDREPORT_OPENAI_API_KEY=

# Model names are configuration, not code - provider line-ups change every few
# months. Set these to whatever you have access to.
# MEDREPORT_MODEL_VISION=gpt-5          # reads pages. needs vision. the expensive one.
# MEDREPORT_MODEL_CHEAP=gpt-5-mini      # per-marker copy, cached across all users
# MEDREPORT_MODEL_STRONG=gpt-5          # cross-marker reasoning and the prep sheet
# MEDREPORT_LLM_TIMEOUT_SECONDS=180
# MEDREPORT_LLM_MAX_ATTEMPTS=4
