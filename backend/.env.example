# Copy to .env and adjust. .env is gitignored and must never be committed.
# Every variable is prefixed BASELINE_ so it cannot collide with anything else
# in the environment.

BASELINE_ENVIRONMENT=local
BASELINE_DEBUG=true

# Comma-separated
BASELINE_CORS_ORIGINS=http://localhost:3000

# --- added in CP5 ---
# BASELINE_DATABASE_URL=postgresql+asyncpg://baseline:baseline@localhost:5432/baseline

